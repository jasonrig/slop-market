{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jasonrig.github.io/slop-market/schemas/codex-marketplace.schema.json",
  "title": "Slop Market Codex Marketplace",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "interface", "plugins"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "shared.schema.json#/$defs/kebabName"
    },
    "interface": {
      "type": "object",
      "additionalProperties": true,
      "required": ["displayName"],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "source", "policy", "category"],
        "properties": {
          "name": {
            "$ref": "shared.schema.json#/$defs/kebabName"
          },
          "source": {
            "$ref": "#/$defs/codexSource"
          },
          "policy": {
            "type": "object",
            "additionalProperties": true,
            "required": ["installation", "authentication"],
            "properties": {
              "installation": {
                "enum": ["NOT_AVAILABLE", "AVAILABLE", "INSTALLED_BY_DEFAULT"]
              },
              "authentication": {
                "enum": ["ON_INSTALL", "ON_USE"]
              },
              "products": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "codexSource": {
      "oneOf": [
        {
          "$ref": "shared.schema.json#/$defs/relativePath"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["source", "path"],
          "properties": {
            "source": {
              "const": "local"
            },
            "path": {
              "$ref": "shared.schema.json#/$defs/relativePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["source", "url"],
          "properties": {
            "source": {
              "const": "url"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "$ref": "shared.schema.json#/$defs/relativePath"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "sha": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["source", "url", "path"],
          "properties": {
            "source": {
              "const": "git-subdir"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "$ref": "shared.schema.json#/$defs/relativePath"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "sha": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
