{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jasonrig.github.io/slop-market/schemas/shared.schema.json",
  "title": "Slop Market Shared Schema Definitions",
  "$defs": {
    "kebabName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^\\./(?!\\.\\.?(?:/|$))(?!.*(?:/)\\.\\.?(?:/|$))(?!.*//)[^\\\\]+$"
    },
    "pathOrPathArray": {
      "oneOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      ]
    },
    "author": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "repository": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["url"],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "directory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
